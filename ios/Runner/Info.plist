<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Mobile App</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>mobile_app</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- ═══════════════════════════════════════════════════════════════════════
	     PERMISOS DE UBICACIÓN — DevUbi / Warey Telemetry Node
	     El OS muestra estas cadenas al usuario en el diálogo de permisos.
	     Deben ser claras y describir exactamente por qué se necesita el permiso.
	     ═══════════════════════════════════════════════════════════════════════ -->

	<!-- Ubicación mientras la app está en uso (primer plano) -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>DevUbi / Warey necesita tu ubicación para registrar y transmitir datos de telemetría al servidor durante el monitoreo activo del nodo.</string>

	<!-- Ubicación siempre (segundo plano) + en uso — Apple exige ambas claves -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>DevUbi / Warey es un nodo de telemetría de campo. Requiere acceso a la ubicación en todo momento (incluso con la pantalla apagada) para transmitir datos de posición GPS en tiempo real al sistema de monitoreo central.</string>

	<!-- Clave legacy requerida para iOS 10 y anteriores — mantener para compatibilidad -->
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Este dispositivo opera como un nodo de telemetría del sistema DevUbi / Warey. El acceso continuo a la ubicación en segundo plano es indispensable para la transmisión ininterrumpida de coordenadas GPS, estado de batería y conectividad al servidor de monitoreo.</string>

	<!-- ═══════════════════════════════════════════════════════════════════════
	     MODOS DE EJECUCIÓN EN SEGUNDO PLANO
	     Declarar los background modes permite al OS no matar la app cuando
	     pasa a background. Apple revisa estas declaraciones en App Store Review.
	     ═══════════════════════════════════════════════════════════════════════ -->
	<key>UIBackgroundModes</key>
	<array>
		<!-- Permite recibir actualizaciones de ubicación con la pantalla apagada -->
		<string>location</string>
		<!-- Permite ejecutar tareas periódicas en background (BGAppRefreshTask) -->
		<string>fetch</string>
		<!-- Permite ejecutar tareas largas en background (BGProcessingTask) -->
		<string>processing</string>
	</array>

	<!-- ═══════════════════════════════════════════════════════════════════════ -->

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
